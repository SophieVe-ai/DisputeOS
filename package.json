{
  "name": "disputeos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "hardhat test",
    "chain": "hardhat node --hostname 127.0.0.1",
    "chain:deploy": "hardhat run scripts/deploy-auditlog.cjs --network localhost",
    "chain:deploy:testnet": "hardhat run scripts/deploy-auditlog.cjs --network testnet",
    "db:reset": "tsx scripts/reset-db.ts",
    "demo": "npm run db:reset && concurrently -k -n chain,app -c magenta,cyan \"npm:chain\" \"wait-on -t 60000 tcp:127.0.0.1:8545 && npm run chain:deploy && cross-env DEMO_MODE=1 next dev --hostname 127.0.0.1\"",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:contracts && npm run build",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "better-sqlite3": "^13.0.3",
    "ethers": "^6.17.0",
    "geist": "^1.7.2",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "chai": "^4.5.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "hardhat": "^2.29.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22"
  }
}
