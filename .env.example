# --- AI engine -------------------------------------------------------------
# Set to enable Claude-powered agents. Without it, the deterministic engine runs.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# DISPUTEOS_ENGINE=deterministic   # force the offline engine even with a key

# --- Blockchain ledger -----------------------------------------------------
# Defaults to the local Hardhat node started by `npm run demo`.
# CHAIN_RPC_URL=http://127.0.0.1:8545
# For a public testnet (e.g. Base Sepolia): deploy with `npm run chain:deploy:testnet`
# TESTNET_RPC_URL=https://sepolia.base.org
# LEDGER_PRIVATE_KEY=0x...          # funded testnet key — never commit
# LEDGER_CONTRACT_ADDRESS=0x...     # overrides .chain/deployment.json

# --- App -------------------------------------------------------------------
# BOE_BASE_RATE=4.0                 # Bank of England base rate used for statutory interest — verify current rate
# DEMO_STEP_DELAY_MS=1200           # pacing so judges can watch agents work (0 = full speed)
# DEMO_MODE=1                       # enables the tamper-simulation endpoint (npm run demo sets this)
# APPROVAL_PIN=                     # require a PIN for approvals
# DATABASE_PATH=./data/disputeos.db
